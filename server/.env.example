# Backend Server Environment Variables
PORT=5000
NODE_ENV=development

# SQLite Database File Location (Defaults to ./data/nxtwave_growth.sqlite)
DATABASE_PATH=./data/nxtwave_growth.sqlite

# Organizer Access Key (Required for organizer-only APIs: registration listings, campaign settings, seed/reset)
# REQUIRED: Set this to a strong random secret before running the server.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORGANIZER_KEY=your-strong-random-secret-here

# Allowed Frontend Origins for CORS (comma-separated). Defaults to local development ports.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# Optional: Google Gemini AI API Key
# If omitted or left empty, the application seamlessly runs using its built-in
# high-impact deterministic Growth Engine fallback without crashing or erroring.
# SECURITY NOTE: Never commit this key to version control or expose it to frontend code.
GEMINI_API_KEY=

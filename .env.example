# Backend Server Environment Variables (copy to server/.env)
PORT=5000
NODE_ENV=development
DATABASE_PATH=./data/nxtwave_growth.sqlite

# Organizer Access Key (Required for organizer-only APIs: registration listings, campaign settings, seed/reset)

ORGANIZER_KEY=replace-with-a-long-random-secret
# Allowed Frontend Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# Optional: Google Gemini AI API Key
# If omitted or left empty, the application functions seamlessly in demo mode
# using its built-in deterministic Growth Engine without throwing errors.
# SECURITY NOTE: Never commit this key to version control or prefix with VITE_.
GEMINI_API_KEY=

# Frontend Vite Environment Variables (optional, defaults to proxy /api)
VITE_API_URL=/api
# Optional: Set organizer key if running without proxy in custom environment

